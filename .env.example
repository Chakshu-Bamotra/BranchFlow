# BranchFlow Environment Configuration Template
# Copy this file to .env and insert your real production secrets.
# NEVER commit the real .env to GitHub!

# Firebase Project Configuration
FIREBASE_PROJECT_ID=branchflow-production
FIREBASE_PROJECT_NUMBER=789746893835
FIREBASE_STORAGE_BUCKET=branchflow-production.appspot.com

# Web Client Credentials
FIREBASE_WEB_API_KEY=your_web_api_key_here
FIREBASE_WEB_APP_ID=1:789746893835:web:ae02f5497693bef638b30e

# Android Client Credentials
FIREBASE_ANDROID_API_KEY=your_android_api_key_here
FIREBASE_ANDROID_APP_ID=1:789746893835:android:9db9e2905709c83138b30e

# Default Library Admin Credentials
DEFAULT_LIBRARIAN_EMAIL=staff@branchflow.lib
DEFAULT_MEMBER_EMAIL=member@branchflow.lib
