rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Branches: Network branches catalog
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // 3. Books: Unified catalog across all community libraries
    match /books/{bookId} {
      allow read, write: if true;
    }

    // 4. Loans: Real-time borrow and cross-branch return ledger
    match /loans/{loanId} {
      allow read, write: if true;
    }

    // 5. Inter-Branch Transit Queue
    match /transit_items/{transitId} {
      allow read, write: if true;
    }

    // 6. Email OTP codes: only Cloud Functions (Admin SDK) may touch these
    match /email_otps/{otpId} {
      allow read, write: if false;
    }
  }
}
